# manual-entries.yaml — manually-declared assignments and upcoming evaluations
#
# Use this file for work you know about but that teachers have not yet published on Pronote.
# Copy to manual-entries.yaml (same directory as config.yaml) and edit as needed.
# The file is silently ignored if absent.
#
# IMPORTANT: subject values must match Pronote's raw subject strings exactly (all-caps,
# with accents as Pronote returns them). Use the values documented below.
# teacher values must also match exactly (used to select teacher-specific enrichment rules,
# e.g. the Histoire / Géographie split). See the teacher reference table below.
#
# All dates are ISO format: YYYY-MM-DD
#
# Manual entries behave like Pronote entries: adding one triggers a "new" push/email
# notification on the next run; removing one triggers a "removed" notification.
#
# ─── SUBJECT & TEACHER REFERENCE ────────────────────────────────────────────
#
#   Teacher names below are PLACEHOLDERS. This file is committed to the repository —
#   keep real teacher names out of it. The authoritative subject/teacher mapping for your
#   own instance lives in config.yaml (gitignored) under subjectEnrichment.rules.
#
#   The subject strings, however, must be copied EXACTLY as Pronote emits them:
#
#   subject (raw Pronote)       enrichedSubject       teacher (timetable form)
#   ────────────────────────    ──────────────────    ─────────────────────────
#   MATHEMATIQUES               Mathématiques         SYN_TEACHER_A
#   FRANCAIS                    Français              SYN_TEACHER_B
#   HISTOIRE-GEOGRAPHIE         Histoire              SYN_TEACHER_C  ← teacher disambiguates
#   HISTOIRE-GEOGRAPHIE         Géographie            SYN_TEACHER_D  ← teacher disambiguates
#   HISTOIRE-GEOGRAPHIE         Histoire-Géo          (any / unknown — subject-only fallback)
#   LANGUE & LITTÉRATURE        Langue & littérature  SYN_TEACHER_E
#   ANGLAIS LV1                 Anglais LV1           SYN_TEACHER_F
#   ESPAGNOL LV2                Espagnol LV2          SYN_TEACHER_G
#   LCA LATIN                   Latin                 SYN_TEACHER_H
#   PHYSIQUE-CHIMIE             Physique-Chimie       SYN_TEACHER_I
#   SCIENCES VIE& TERRE         SVT                   SYN_TEACHER_J
#   TECHNOLOGIE                 Technologie           SYN_TEACHER_K
#   ARTS PLASTIQUES             Arts plastiques       SYN_TEACHER_L
#   MUSIQUE                     Musique               SYN_TEACHER_M
#   ED.PHYSIQUE & SPORT.        EPS                   SYN_TEACHER_N
#   VIE DE CLASSE               Vie de classe         SYN_TEACHER_O
#
#   Watch the exact spelling of the raw strings — several are irregular and an inexact
#   match silently falls through to the raw all-caps form:
#     "SCIENCES VIE& TERRE"   no space BEFORE the ampersand, one space after
#     "LANGUE & LITTÉRATURE"  spaces on both sides, accented É
#     "ED.PHYSIQUE & SPORT."  leading "ED." and a trailing period
#     "FRANCAIS"              no cedilla
#
#   For evaluations, Pronote prefixes teacher names with a civil title ("Mme SYN_TEACHER_A").
#   Both the prefixed and the bare form ("SYN_TEACHER_A") are accepted in manual entries —
#   subjectEnrichment.teacherPrefixes strips the prefix automatically.
#
# ─── PERIOD NAMES (for evaluations) ─────────────────────────────────────────
#
#   "Trimestre 1"  (Sept – Dec)
#   "Trimestre 2"  (Jan – Mar)
#   "Trimestre 3"  (Apr – Jun)
#
# ─────────────────────────────────────────────────────────────────────────────

assignments:

  # ── Minimal example (only required fields) ───────────────────────────────
  - subject: "MATHEMATIQUES"
    description: "DS sur les fractions et nombres mixtes"
    dueDate: "2026-04-25"

  # ── With optional assignedDate ────────────────────────────────────────────
  - subject: "FRANCAIS"
    description: "Lire L'Odyssée pages 57 à 85 et compléter le livret"
    dueDate: "2026-04-28"
    assignedDate: "2026-04-17"   # when the work was given; defaults to dueDate if omitted

  # ── Mark as already done (renders with strikethrough + "Fait" badge) ─────
  - subject: "MATHEMATIQUES"
    description: "Exercices page 34"
    dueDate: "2026-04-20"
    done: true

  # ── Stable id — survives typo fixes without churning the diff ────────────
  # Without id:, fixing a typo in description changes the snapshot ID, which
  # the next run reports as "removed + new" (extra notification pair). Setting
  # id: pins the identity to a short user-chosen key.
  - id: math-fractions-2604
    subject: "MATHEMATIQUES"
    description: "Révision fractions équivalentes"
    dueDate: "2026-04-26"

  # ── Histoire — teacher disambiguates enrichment (→ "Histoire") ───────────
  - subject: "HISTOIRE-GEOGRAPHIE"
    description: "Apprendre le cours sur la naissance du monothéisme"
    dueDate: "2026-04-24"

  # ── Géographie — no teacher needed in assignments (no timetable cross-ref for manual) ──
  - subject: "HISTOIRE-GEOGRAPHIE"
    description: "Réviser les capitales européennes pour interrogation orale"
    dueDate: "2026-04-29"

  # ── Sciences ──────────────────────────────────────────────────────────────
  - subject: "SCIENCES VIE& TERRE"
    description: "Préparer le contrôle sur les chaînes alimentaires"
    dueDate: "2026-04-30"

  - subject: "PHYSIQUE-CHIMIE"
    description: "Réviser le chapitre sur l'énergie (exercices 1 à 5)"
    dueDate: "2026-04-23"

  # ── English ───────────────────────────────────────────────────────────────
  - subject: "LANGUE & LITTÉRATURE"
    description: "Read The Giver chapters 10–12 and complete workbook p. 7"
    dueDate: "2026-04-22"

  - subject: "ANGLAIS LV1"
    description: "Vocabulary list unit 8 — learn 20 words"
    dueDate: "2026-04-25"

  # ── Arts ──────────────────────────────────────────────────────────────────
  - subject: "ARTS PLASTIQUES"
    description: "Finir le projet Aéropostale — coloriage et légendes"
    dueDate: "2026-04-28"

  - subject: "MUSIQUE"
    description: "Apprendre le solfège — exercices p. 12 à 14"
    dueDate: "2026-04-24"

  - subject: "ED.PHYSIQUE & SPORT."
    description: "Apporter tenue de sport et chaussures"
    dueDate: "2026-04-22"


evaluations:

  # ── Minimal example (only required fields) ───────────────────────────────
  - subject: "MATHEMATIQUES"
    name: "Test nombres mixtes et fractions d'une quantité"
    date: "2026-04-25"

  # ── With all optional fields ──────────────────────────────────────────────
  - id: ds3-maths-0605                # optional — stable key (survives name edits)
    subject: "MATHEMATIQUES"
    name: "DS 3 - fractions et pourcentages"
    date: "2026-05-06"
    teacher: "Mme SYN_TEACHER_A"      # optional — enables teacher-specific enrichment rules
    description: "Chapitres 6 et 7 — fractions, nombres mixtes, pourcentages"
    periodName: "Trimestre 3"    # optional — "Trimestre 1" / "Trimestre 2" / "Trimestre 3"

  # ── Français ──────────────────────────────────────────────────────────────
  - subject: "FRANCAIS"
    name: "Evaluation finale séquence 4 — L'Odyssée"
    date: "2026-05-12"
    teacher: "Mme SYN_TEACHER_B"
    description: "Compréhension de texte + questions de grammaire"
    periodName: "Trimestre 3"

  - subject: "FRANCAIS"
    name: "Dictée 4"
    date: "2026-04-28"
    teacher: "Mme SYN_TEACHER_B"
    periodName: "Trimestre 3"

  # ── Histoire (teacher → enrichedSubject = "Histoire") ────────────────────
  - subject: "HISTOIRE-GEOGRAPHIE"
    name: "Rome des origines à l'Empire — contrôle de cours"
    date: "2026-04-29"
    teacher: "M. SYN_TEACHER_C"
    periodName: "Trimestre 3"

  # ── Géographie (teacher → enrichedSubject = "Géographie") ────────────────
  - subject: "HISTOIRE-GEOGRAPHIE"
    name: "Living in Low Density Spaces — test"
    date: "2026-05-05"
    teacher: "M. SYN_TEACHER_D"
    periodName: "Trimestre 3"

  # ── Langue & Littérature ─────────────────────────────────────────────────
  - subject: "LANGUE & LITTÉRATURE"
    name: "The Giver: Final Exam"
    date: "2026-05-08"
    teacher: "M. SYN_TEACHER_E"
    periodName: "Trimestre 3"

  # ── Sciences Vie & Terre ─────────────────────────────────────────────────
  - subject: "SCIENCES VIE& TERRE"
    name: "Evaluation La place des êtres vivants dans les chaînes alimentaires"
    date: "2026-04-30"
    teacher: "Mme SYN_TEACHER_J"
    periodName: "Trimestre 3"

  # ── Physique-Chimie ───────────────────────────────────────────────────────
  - subject: "PHYSIQUE-CHIMIE"
    name: "DS énergie et transformations"
    date: "2026-04-23"
    teacher: "M. SYN_TEACHER_I"
    periodName: "Trimestre 3"

  # ── Arts Plastiques ───────────────────────────────────────────────────────
  - subject: "ARTS PLASTIQUES"
    name: "Questions de cours"
    date: "2026-05-07"
    teacher: "M. SYN_TEACHER_L"
    periodName: "Trimestre 3"

  # ── Musique ───────────────────────────────────────────────────────────────
  - subject: "MUSIQUE"
    name: "Solfège"
    date: "2026-05-14"
    teacher: "M. SYN_TEACHER_M"
    periodName: "Trimestre 3"
